# Copy to .env; never commit credentials.
PORT=8787
NETWORK=hsk-testnet
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Deployed CertiAgentRegistry address for each network. Leave empty before deployment.
HSK_TESTNET_CONTRACT=
HSK_MAINNET_CONTRACT=
SEPOLIA_CONTRACT=
# IMPORTANT: independent NEW, disposable agent wallet; NOT a seed/recovery phrase or the wallet from any submitted document.
AGENT_PRIVATE_KEY=
# Agent must be explicitly authorized by contract owner via UI.
INBOX_DIR=./inbox
STORAGE_DIR=./storage
POLL_MS=2500
MAX_FILE_MB=10
# Optional local AI: requires an Ollama server on this machine and a pulled model.
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
